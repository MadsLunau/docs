{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Parahelp docs",
  "colors": {
    "primary": "#173167",
    "light": "#D5DCF0",
    "dark": "#1B1917"
  },
  "favicon": "/favicon.svg",
  "navigation": {
  "groups": [
    {
      "group": "Get started",
      "pages": [
        "get-started/introduction",
        "get-started/concepts",
        "get-started/quickstart"
      ]
    },
    {
      "group": "Customer agent",
      "pages": [
        "customer-agent/introduction",
        {
          "group": "Channels",
          "pages": [
            "customer-agent/channels",
            "customer-agent/ticketing-system",
            "customer-agent/api",
            "guides/zendesk-setup",
            "guides/plain-setup",
            "guides/pylon-setup",
            "guides/intercom-setup"
          ]
        },
        "customer-agent/tools",
        "customer-agent/memory",
        "customer-agent/knowledge",
        "customer-agent/guardrails"
      ]
    },
    {
      "group": "Internal agent",
      "pages": [
        "internal-agent/introduction",
        "internal-agent/build",
        "internal-agent/test",
        "internal-agent/release",
        "internal-agent/improve"
      ]
    },
    {
      "group": "Platform",
      "pages": [
        "platform/tasks",
        "platform/connections",
        "platform/automations",
        "platform/inbox",
        "platform/settings"
      ]
    },
    {
      "group": "Resources",
      "pages": [
        "resources/faq",
        "resources/changelog"
      ]
    }
  ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@parahelp.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Login",
      "href": "https://app.parahelp.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/parahelp_ai",
      "linkedin": "https://linkedin.com/company/parahelp-ai"
    }
  },
  "seo": {
    "metatags": {
      "robots": "noindex"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "redirects": [
    {
      "source": "/manager/introduction",
      "destination": "/internal-agent/how-it-works"
    },
    {
      "source": "/manager/tasks",
      "destination": "/platform/chats"
    },
    {
      "source": "/manager/actions",
      "destination": "/platform/actions"
    },
    {
      "source": "/manager/automations",
      "destination": "/platform/continuous-tasks"
    },
    {
      "source": "/manager/settings",
      "destination": "/platform/settings"
    },
    {
      "source": "/manager/manager-agent/connections",
      "destination": "/internal-agent/tools"
    },
    {
      "source": "/manager/manager-agent/best-practices",
      "destination": "/internal-agent/best-practices"
    },
    {
      "source": "/customer-agent/introduction",
      "destination": "/customer-agent/how-it-works"
    },
    {
      "source": "/customer-agent/channels/ticketing-systems",
      "destination": "/ticketing-systems"
    },
    {
      "source": "/customer-agent/channels/ticketing-systems-2",
      "destination": "/ticketing-systems"
    },
    {
      "source": "/customer-agent/how-it-works",
      "destination": "/customer-agent/introduction"
    },
    {
      "source": "/customer-agent/configurations",
      "destination": "/customer-agent/introduction"
    },
    {
      "source": "/customer-agent/testing",
      "destination": "/internal-agent/test"
    },
    {
      "source": "/customer-agent/reporting",
      "destination": "/internal-agent/improve"
    },
    {
      "source": "/internal-agent/how-it-works",
      "destination": "/internal-agent/introduction"
    },
    {
      "source": "/internal-agent/best-practices",
      "destination": "/internal-agent/introduction"
    },
    {
      "source": "/internal-agent/tools",
      "destination": "/platform/connections"
    },
    {
      "source": "/platform/actions",
      "destination": "/internal-agent/release"
    },
    {
      "source": "/platform/chats",
      "destination": "/platform/tasks"
    },
    {
      "source": "/platform/continuous-tasks",
      "destination": "/platform/automations"
    },
    {
      "source": "/ticketing-systems",
      "destination": "/customer-agent/ticketing-system"
    },
    {
      "source": "/api",
      "destination": "/customer-agent/api"
    }
  ],
  "appearance": {
    "default": "light",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#FAFAF9",
      "dark": "#1B1917"
    }
  }
}
